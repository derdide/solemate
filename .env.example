# Optional. The app needs no configuration and no secrets — copy this file to .env
# only if you want to change the request limits below.

# Largest accepted photo upload, in MB
MAX_UPLOAD_MB=25

# Largest accepted photo, in megapixels (width × height).
# Peak server memory is roughly 25 MB per megapixel; keep it consistent with
# mem_limit in docker-compose.yml.
MAX_IMAGE_MEGAPIXELS=50
