# Serves the app as static files on :8000. No TLS here — put your own
# reverse proxy (or Cloudflare Tunnel) in front.
{
	admin off
	auto_https off
	persist_config off
}

:8000 {
	root * /srv
	encode zstd gzip

	# Kept for existing monitors that poll the old API health endpoint
	handle /api/health {
		header Content-Type application/json
		respond `{"status":"ok"}` 200
	}

	handle {
		header {
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy no-referrer
			Cross-Origin-Opener-Policy same-origin
			Content-Security-Policy "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			# Templates and scripts change with a redeploy: let browsers revalidate
			Cache-Control "no-cache"
			-Server
		}
		# The page only ever reads: anything else is refused
		@write not method GET HEAD
		respond @write 405
		file_server
	}
}
